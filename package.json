{
  "name": "osm-navigator-monorepo",
  "private": true,
  "version": "0.0.1",
  "license": "GPL-3.0-or-later",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p apps/navigation-example && tsc -p apps/navigation-example/tsconfig.test.json && tsc -p packages/core/tsconfig.test.json && tsc -p packages/ui-navigation/tsconfig.test.json",
    "lint": "eslint .",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "babel-preset-expo": "~57.0.13",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "jest-expo": "~57.0.5",
    "test-renderer": "^1.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0"
  },
  "packageManager": "yarn@1.22.22"
}
