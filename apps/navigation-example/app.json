{
  "expo": {
    "name": "OSM Navigation Example",
    "slug": "navigation-example",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.osmnavigator.navigationexample"
    },
    "android": {
      "package": "com.osmnavigator.navigationexample"
    },
    "scheme": "osm-navigation-example",
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "OSM Navigation Example uses your location to show where you are on the map and guide you along your route."
        }
      ]
    ]
  }
}
